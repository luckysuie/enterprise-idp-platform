subscription_id    = "00000000-0000-0000-0000-0000000000000000000"
location           = "Central India"
environment        = "dev"
project_name       = "enterprise-idp"
resource_group_name = "enterprise-idp-dev-rg"

tags = {
  Project     = "Enterprise-IDP"
  Environment = "Development"
  ManagedBy   = "Terraform"
  Owner       = "Platform-Engineering"
}

vnet_name          = "enterprise-idp-dev-vnet"
vnet_address_space = ["10.10.0.0/16"]

aks_subnet_name             = "aks-subnet"
aks_subnet_address_prefixes = ["10.10.1.0/24"]

app_subnet_name             = "app-subnet"
app_subnet_address_prefixes = ["10.10.2.0/24"]

private_endpoint_subnet_name             = "private-endpoint-subnet"
private_endpoint_subnet_address_prefixes = ["10.10.3.0/24"]

aks_name           = "enterprise-idp-dev-aks"
aks_dns_prefix     = "enterprise-idp-dev"
aks_node_vm_size   = "Standard_D2s_v3"
aks_min_node_count = 1
aks_max_node_count = 1

acr_name = "enterpriseidpacr"
acr_sku  = "Basic"
key_vault_name                 = "enterprise-idp-kv-1234"
workload_identity_name         = "enterprise-idp-dev-workload-id"
kubernetes_namespace           = "platform"
kubernetes_service_account_name = "platform-workload"
